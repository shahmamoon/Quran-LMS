# ─── AI ───────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# ─── Database — local Docker PostgreSQL ───────────────────────
# Run: docker compose up -d postgres
DATABASE_URL="postgresql://lmsuser:lmspassword@localhost:5432/quranacademy"

# ─── JWT Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="dev_secret_32chars_change_in_prod_!!!"
JWT_REFRESH_SECRET="dev_refresh_32chars_change_in_prod!!"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Email / SMTP ─────────────────────────────────────────────
# Leave blank to skip emails — they are logged to console instead.
#
# For Titan email (production):
#   SMTP_HOST="smtp.titan.email"
#   SMTP_PORT="465"    # 465 = SSL/TLS | 587 = STARTTLS
#   SMTP_USER="noreply@yourdomain.com"
#   SMTP_PASS="your-titan-password"
#
# For Gmail (dev): use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Online Quran Academy <noreply@quranacademy.com>"

# ─── Zoom (Server-to-Server OAuth) ───────────────────────────
# 1. Go to https://marketplace.zoom.us/
# 2. Create a "Server-to-Server OAuth" app and activate it
# 3. Copy the credentials below
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"

# ─── Server ───────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"
CLIENT_URL="http://localhost:3000"
