# ═══════════════════════════════════════════════════════════════
#  Build AI With Us — PRODUCTION environment variables
#
#  1. Copy this file to /opt/buildaiwithus/.env.production
#  2. Fill in every placeholder (no empty required values in prod)
#  3. Also create /opt/buildaiwithus/.env.production for
#     docker-compose.prod.yml to pick up DB_PASS etc.
# ═══════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV="production"
PORT="4000"

# Your production domain (no trailing slash)
CLIENT_URL="https://yourdomain.com"
APP_URL="https://yourdomain.com"

# ─── Database ─────────────────────────────────────────────────
# The Docker service name "postgres" is the hostname inside Docker network
DATABASE_URL="postgresql://lmsuser:CHANGE_ME_DB_PASSWORD@postgres:5432/buildaiwithus"

# These are used by docker-compose.prod.yml to initialise the postgres container
DB_USER="lmsuser"
DB_PASS="CHANGE_ME_DB_PASSWORD"     # must match the password in DATABASE_URL
DB_NAME="buildaiwithus"

# ─── JWT secrets (generate with: openssl rand -hex 32) ────────
JWT_SECRET="CHANGE_ME_run_openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_run_openssl_rand_hex_32_again"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Email / Titan SMTP ───────────────────────────────────────
# Titan email: https://titan.email → Settings → IMAP/SMTP
# Use port 465 (SSL/TLS) or 587 (STARTTLS)
SMTP_HOST="smtp.titan.email"
SMTP_PORT="465"
SMTP_USER="noreply@yourdomain.com"   # your Titan email address
SMTP_PASS="CHANGE_ME_TITAN_PASSWORD"
SMTP_FROM="Build AI With Us <noreply@yourdomain.com>"

# ─── Zoom (Server-to-Server OAuth) ───────────────────────────
# https://marketplace.zoom.us → your Server-to-Server OAuth app
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"

# ─── Gemini AI (optional) ─────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"
